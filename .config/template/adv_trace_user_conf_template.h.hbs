{{assign 'advanced_traceFilter' (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "ADVANCED_TRACE"}')~}}
{{assign 'advanced_trace_context' (@root.SWConfigurationAPI.getInstancesConfiguration @root.advanced_traceFilter)~}}
{{assign 'advanced_trace_cxt' @root.advanced_trace_context.[0].settings.parameters~}}
{{log "advanced_trace Config template advanced_trace_cxt:" (toJSON @root.advanced_trace_cxt)~}}
/**
  **********************************************************************************************************************
  * @file    adv_trace_user_conf.h
  * @brief   Advanced Trace configuration header file
{{> LICENSE}}

{{#with @root.advanced_trace_cxt~}}

/* Define to prevent recursive inclusion -----------------------------------------------------------------------------*/
#ifndef ADV_TRACE_USER_CONF_H
#define ADV_TRACE_USER_CONF_H
#ifdef __cplusplus
extern "C" {
#endif

/* Includes ----------------------------------------------------------------------------------------------------------*/
#include <cmsis_compiler.h>
#include <stdio.h>
#include <string.h>

{{#with additional~}}
/* Exported macros ---------------------------------------------------------------------------------------------------*/

{{#if conditional }}
/**
  * @brief  Enable conditional logging support.
  */
#define ADV_TRACE_CONDITIONAL
{{/if}}{{!conditional}}
{{#if unchunk_mode}}
/**
  * @brief  Enable unchunk transmission mode.
  */
#define ADV_TRACE_UNCHUNK_MODE
{{/if}}{{!unchunk_mode}}
{{#if trace_overrun}}
/**
  * @brief  Enable overrun detection support.
  */
#define ADV_TRACE_OVERRUN
{{/if}}{{!trace_overrun}}

/**
  * @brief  Definition of the maximum size for the temporary trace formatting buffer.
  */
#define ADV_TRACE_MAX_FORMAT_BUF_SIZE         {{#if buffer_size}}({{buffer_size}}U){{else}}(128){{/if}}{{!buffer_size}}
{{#if conditional }}{{#if conditional_mode.set_timestamp }}

/**
  * @brief  Definition of the maximum size reserved for the formatted trace timestamp.
  */
#define ADV_TRACE_MAX_TIMESTAMP_SIZE          {{#if conditional_mode.timestamp_config.timestamp_size}}({{conditional_mode.timestamp_config.timestamp_size}}U){{else}}(15U){{/if}}{{!conditional_mode.timestamp_size}}
{{/if}}{{!conditional_mode.set_timestamp}}{{/if}}{{!conditional}}{{/with~}}{{!additional}}

{{#with basic~}}
/**
  * @brief  Definition of the trace FIFO size.
  */
#define ADV_TRACE_FIFO_SIZE                     {{#if fifo_size}}({{fifo_size}}U){{else}}(2024U){{/if}}{{!fifo_size}}

{{#if override_mem_section}}
/* Optional user-defined memory location override for the trace buffer. */
#define ADV_TRACE_MEMLOCATION               __attribute__((section("{{memory_section}}"), aligned(1)))
{{/if~}}{{!override_mem_section}}

{{/with~}}{{!basic}}
/**
  * @brief  Macro used to initialize the critical section.
  */
#define ADV_TRACE_INIT_CRITICAL_SECTION( )

/**
  * @brief  Macro used to enter the critical section.
  */
#define ADV_TRACE_ENTER_CRITICAL_SECTION( )   uint32_t primask_bit = __get_PRIMASK( );\
  __disable_irq( )

/**
  * @brief  Macro used to exit the critical section.
  */
#define ADV_TRACE_EXIT_CRITICAL_SECTION( )    __set_PRIMASK( primask_bit )

/**
  * @brief  Memory fill macro.
  */
#define ADV_TRACE_MEMSET8(dest, value, size)  memset((dest), (value), (size));

/**
  * @brief  Formatted output macro mapped to vsnprintf.
  */
#define ADV_TRACE_VSNPRINTF(...)              vsnprintf(__VA_ARGS__)

#ifdef __cplusplus
}
#endif
{{/with}}{{!advanced_trace_cxt}}
#endif /* ADV_TRACE_USER_CONF_H */
